{
  "name": "slack-gtm-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A Slack bot that answers go-to-market questions with CompanyEnrich data, with a visible plan and a credit approval step, using the official CompanyEnrich MCP server as its tool layer.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "simulate": "tsx scripts/simulate.ts",
    "tools": "tsx scripts/list-tools.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@companyenrich/mcp": "^2.0.0",
    "@companyenrich/sdk": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@modelcontextprotocol/server": "^2.4.0",
    "undici": "^7.30.2"
  }
}
