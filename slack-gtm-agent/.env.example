# Required: CompanyEnrich API key (https://companyenrich.com/dashboard)
COMPANYENRICH_API_KEY=

# Required: from your Slack app's "Basic Information" and "OAuth & Permissions" pages
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-

# Optional: turns on agent mode (@mentions answered by Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: HTTP port for /slack/events (default 3000)
# PORT=3000

# Optional: credit safety (defaults shown)
# CE_APPROVAL_THRESHOLD=10
# CE_QUESTION_CAP=50
# CE_DAILY_USER_CAP=200
# CE_DAILY_TOTAL_CAP=1000
# CE_LEDGER_FILE=state/ledger.json

# Optional: Slack Web API base URL. Only for pointing the bot at a local mock.
# SLACK_API_URL=https://slack.com/api/
