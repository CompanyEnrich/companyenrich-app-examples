# Required. Get a key at https://companyenrich.com/dashboard
# Used only on the server, by the /api/company route handler.
COMPANYENRICH_API_KEY=

# Optional. Number of reverse proxies you run in front of the app that append
# the client address to X-Forwarded-For (for example 1 behind one nginx).
# Leave empty when the app is exposed directly: X-Forwarded-For is then not
# trusted, and all visitors share one rate-limit bucket. Ignored on Vercel,
# where the platform's own client IP header is used.
TRUST_PROXY=
