# Required. Get a key at https://companyenrich.com/dashboard
COMPANYENRICH_API_KEY=

# Optional. Lets Claude draft a custom committee from a free-text "what you sell".
# Without it, the description is matched to the nearest preset by keywords.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional, web server only. Total credits the server may spend since it started.
MAP_MAX_CREDITS=300
REVEAL_MAX_CREDITS=50
