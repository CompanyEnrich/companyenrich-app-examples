# Required for enrichment. Get a key at https://companyenrich.com/dashboard
COMPANYENRICH_API_KEY=

# Required in production (npm start). POST /api/inbound and /api/playground then
# require the header `x-webhook-secret: <this value>`; without it they answer 503.
INBOUND_WEBHOOK_SECRET=

# Optional. Set to 1 to run a production build without a secret, for a local demo only.
ALLOW_UNAUTHENTICATED_WEBHOOK=

# Optional. The most one webhook lead may spend, checked before each paid call. Default 10.
MAX_CREDITS_PER_LEAD=

# Optional. Slack incoming webhook URL for lead alerts. Without it, alerts are logged.
SLACK_WEBHOOK_URL=

# Optional. Stop paid calls once this many credits were spent today (UTC). Default 250.
DAILY_CREDIT_CAP=

# Optional. Requests per minute for the API routes, shared by all clients. Default 60.
RATE_LIMIT_PER_MINUTE=

# Optional. Set to 1 only behind a proxy that appends the client address to
# X-Forwarded-For; the rate limit then counts per address (the right-most hop).
TRUST_PROXY=

# Optional. Where the enrichment cache and round-robin state live. Default ./state
STATE_DIR=
