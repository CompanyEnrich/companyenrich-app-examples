# Needed for `generate` and the claude-with-companyenrich adapter. Create a key at https://companyenrich.com/dashboard
COMPANYENRICH_API_KEY=

# Needed only for the two Claude adapters. The oracle and abstain baselines run without it.
ANTHROPIC_API_KEY=

# Optional. The Claude model to evaluate. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
