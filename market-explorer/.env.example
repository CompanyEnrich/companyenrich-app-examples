# Your CompanyEnrich API key. Create one at https://companyenrich.com/dashboard
# Copy this file to .env.local and fill it in. It is read only on the server.
COMPANYENRICH_API_KEY=

# Paid sample search (1 credit per company, at most 10 per request) is OFF unless set to true.
# Leave it false on a public deployment: the app then only uses free endpoints.
ENABLE_PAID_SEARCH=false

# Caps that apply when paid search is on. Whole numbers; 0 blocks all paid searches.
SEARCH_MAX_CREDITS_PER_DAY=50
SEARCH_MAX_PER_IP_PER_HOUR=5

# Set to 1 only behind your own reverse proxy that appends the client address to X-Forwarded-For.
# Otherwise all clients share one paid-search bucket. On Vercel the platform header is used automatically.
TRUST_PROXY=
